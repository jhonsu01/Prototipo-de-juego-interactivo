# Normalización de fin de línea
* text=auto

# Scripts que DEBEN conservar LF (se ejecutan en Linux/CI)
gradlew        text eol=lf
*.sh           text eol=lf

# Scripts de Windows
gradlew.bat    text eol=crlf

# Binarios (nunca tocar EOL)
*.jar          binary
*.png          binary
*.jks          binary
*.keystore     binary
